{
  "name": "LARA — Universal Sharing",
  "short_name": "LARA",
  "description": "Teile Dateien mit Geräten in deiner Nähe",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#FEF7FF",
  "theme_color": "#6750A4",
  "orientation": "any",
  "categories": ["utilities", "productivity"],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": ["*/*"]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "/static/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/static/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
